/* images */
var file=document.getElementById('file'),cur=null;
function load(f,s){
 if(!f||f.type.indexOf('image')!==0)return;
 var r=new FileReader();r.onload=function(){var im=new Image();im.onload=function(){
  var m=1400,sc=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement('canvas');
  c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);c.getContext('2d').drawImage(im,0,0,c.width,c.height);
  var u=c.toDataURL('image/jpeg',.82);setImg(s,u);
  if(!put('img:'+s.dataset.k,u))toast('Foto añadida, pero no cabe en la memoria del navegador y no se conservará al recargar.');
 };im.src=r.result};r.readAsDataURL(f)}
file.onchange=function(){if(cur)load(file.files[0],cur);file.value=''};
var lb=document.getElementById('lb');
lb.querySelector('button').onclick=function(){lb.close()};lb.onclick=function(e){if(e.target===lb)lb.close()};
[].forEach.call(slots,function(s){
 s.addEventListener('click',function(e){
  if(e.target.classList.contains('x')){setImg(s,null);put('img:'+s.dataset.k,null);return}
  if(document.body.classList.contains('edit')){cur=s;file.click()}
  else if(s.classList.contains('has')){lb.querySelector('img').src=s.querySelector('img').src;lb.showModal()}
 });
 s.addEventListener('dragover',function(e){if(document.body.classList.contains('edit')){e.preventDefault();s.classList.add('drag')}});
 s.addEventListener('dragleave',function(){s.classList.remove('drag')});
 s.addEventListener('drop',function(e){e.preventDefault();s.classList.remove('drag');if(document.body.classList.contains('edit'))load(e.dataTransfer.files[0],s)});
});
})();
</script>


