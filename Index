var ST;try{ST=window.localStorage;ST.getItem('x')}catch(e){ST=null}
function get(k){try{return ST&&ST.getItem(k)}catch(e){return null}}
function put(k,v){try{if(ST){v===null?ST.removeItem(k):ST.setItem(k,v)}return true}catch(e){return false}}
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.style.display='block';setTimeout(function(){t.style.display='none'},3200)}
function setImg(s,u){var im=s.querySelector('img');if(u){im.src=u;s.classList.add('has')}else{im.removeAttribute('src');s.classList.remove('has')}}
var slots=document.querySelectorAll('.slot');
[].forEach.call(slots,function(s){var v=get('img:'+s.dataset.k);if(v)setImg(s,v)});
/* text */
var es=document.querySelectorAll('[data-e]');
[].forEach.call(es,function(e,i){var v=get('txt:'+i);if(e.hasAttribute('data-fixed')&&!get('fix:'+i)){put('txt:'+i,null);put('fix:'+i,'1');v=null}if(v!==null&&v!==undefined)e.textContent=v;e.addEventListener('input',function(){put('txt:'+i,e.textContent)})});
function setEdit(on){document.body.classList.toggle('edit',on);
 [].forEach.call(es,function(e){e.contentEditable=on?'true':'false'});
 toast(on?'Modo edición activado: pulsa un recuadro para añadir foto o edita cualquier texto':'Modo edición desactivado')}
